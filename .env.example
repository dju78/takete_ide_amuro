# ─────────────────────────────────────────────────────────────────
# Takete-Ide Amuro — Environment Variables
# Copy this file to `.env.local` for local development.
# The site builds and runs with ALL of these unset — every integration
# degrades gracefully (empty states / disabled features) when absent.
# ─────────────────────────────────────────────────────────────────

# ── Supabase (required for database, auth, storage) ────────────────
# From your Supabase project's Settings → API page.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. NEVER expose this to the client or commit it.
SUPABASE_SERVICE_ROLE_KEY=

# ── Site ─────────────────────────────────────────────────────────
# Canonical base URL used for metadata, sitemap, OG tags. No domain has
# been purchased yet — set this once taketeideamuro.org (or similar) is live.
NEXT_PUBLIC_SITE_URL=https://taketeideamuro.org

# ── Weather (AccuWeather) — optional ────────────────────────────────
# Server-only secret. Get from https://developer.accuweather.com/.
ACCUWEATHER_API_KEY=
# Takete-Ide's AccuWeather location key (already resolved — safe default).
ACCUWEATHER_LOCATION_KEY=923542
# Public fallback link shown when live data is unavailable.
NEXT_PUBLIC_ACCUWEATHER_FORECAST_URL=https://www.accuweather.com/en/ng/takete-ide/923542/weather-forecast/923542

# ── Transactional email — optional ──────────────────────────────────
# Any provider works as long as lib/email (future) is implemented against it.
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM=
# Where admin notification emails (new contact message, etc.) should go.
CONTACT_NOTIFY_EMAIL=

# ── Analytics — optional, disabled by default ───────────────────────
# Leave unset to run with zero third-party tracking (see docs/DECISIONS.md).
# NEXT_PUBLIC_ANALYTICS_PROVIDER=
# NEXT_PUBLIC_ANALYTICS_ID=

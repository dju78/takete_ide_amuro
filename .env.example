# ─────────────────────────────────────────────────────────────────
# Takete-Ide Amuro — Environment Variables
# Copy this file to `.env.local` for local development.
# The site builds and runs with ALL of these unset — every integration
# degrades gracefully (empty states / disabled features) when absent.
# ─────────────────────────────────────────────────────────────────

# ── Supabase (required for database, auth, storage) ────────────────
# From your Supabase project's Settings → API page.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. NEVER expose this to the client or commit it.
SUPABASE_SERVICE_ROLE_KEY=

# ── Site ─────────────────────────────────────────────────────────
# Canonical base URL used for metadata, sitemap, OG tags. No domain has
# been purchased yet — set this once taketeideamuro.org (or similar) is live.
NEXT_PUBLIC_SITE_URL=https://taketeideamuro.org

# ── Weather (AccuWeather) — optional ────────────────────────────────
# Server-only secret. Get from https://developer.accuweather.com/.
ACCUWEATHER_API_KEY=
# Takete-Ide's AccuWeather location key (already resolved — safe default).
ACCUWEATHER_LOCATION_KEY=923542
# Public fallback link shown when live data is unavailable.
NEXT_PUBLIC_ACCUWEATHER_FORECAST_URL=https://www.accuweather.com/en/ng/takete-ide/923542/weather-forecast/923542

# ── Transactional email — optional ──────────────────────────────────
# Any provider works as long as lib/email (future) is implemented against it.
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM=
# Where admin notification emails (new contact message, etc.) should go.
CONTACT_NOTIFY_EMAIL=

# ── Paystack (online contributions) — optional ──────────────────────
# Names only. NEVER commit real key values, and never use a live key in
# development. Keys are self-describing: the test-prefixed pair puts the site in
# test mode, and the matching live-prefixed keys put it in production. The app
# derives the mode from the key's own prefix rather than a separate flag, so a
# test key can never be mistaken for production.
#
# Server-only. Used to initialize transactions, verify them, and validate the
# HMAC SHA-512 signature on incoming webhooks. Never exposed to the browser.
# This is the only Paystack key the site needs: checkout is a server-side
# redirect to Paystack's own hosted page, so no publishable key is used.
PAYSTACK_SECRET_KEY=
#
# Paystack signs webhooks with the SECRET key above — no separate webhook
# secret is required, so none is defined here.
#
# Contribution bounds in naira. Operational guards against typos and abuse,
# not legal limits. Defaults: 100 and 5000000.
CONTRIBUTION_MIN_AMOUNT=
CONTRIBUTION_MAX_AMOUNT=
#
# NEXT_PUBLIC_SITE_URL (set above) is required for online payments: it builds
# the Paystack callback URL. In production it must be the real site origin
# (https://takete.netlify.app) or contributors will be returned to the wrong host.

# ── Analytics — optional, disabled by default ───────────────────────
# Leave unset to run with zero third-party tracking (see docs/DECISIONS.md).
# NEXT_PUBLIC_ANALYTICS_PROVIDER=
# NEXT_PUBLIC_ANALYTICS_ID=
